NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_TIMEZONE=Asia/Dhaka
WEB_URL=http://localhost:3001
SWAGGER_ENABLED=true

DB_HOST=localhost
DB_PORT=13306
DB_USERNAME=medibook
DB_PASSWORD=medibook
DB_DATABASE=medibook
DB_SYNCHRONIZE=false
DB_SSL=false
DB_SSL_CA=
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=10000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_TLS_CA=
REDIS_CONNECTION_TIMEOUT_MS=10000

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

THROTTLE_TTL=60000
THROTTLE_LIMIT=100
LOGIN_THROTTLE_LIMIT=5

MIN_BOOKING_LEAD_MINUTES=30
MAX_SLOTS_PER_REQUEST=200

SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

QUEUE_ENABLED=true
LOG_LEVEL=info
TRUST_PROXY=false
COOKIE_SAME_SITE=lax

# Local-only demo seed, ignored when NODE_ENV=production.
DEMO_SEED_PASSWORD=MediBookDemo123!

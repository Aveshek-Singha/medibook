    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "1.20.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "typescript": "5.9.3"
  }
}

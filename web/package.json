{
  "name": "medibook-web",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.9 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
